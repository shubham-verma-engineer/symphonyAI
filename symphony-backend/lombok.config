# Stop Lombok from searching parent directories for more config.
config.stopBubbling = true

# Copy these annotations from a field onto the parameter of the constructor
# generated by @RequiredArgsConstructor / @AllArgsConstructor. Without this,
# a field-level @Qualifier is dropped from the generated constructor, so Spring
# can't disambiguate when two beans of the same type exist (e.g. our
# documentProcessorExecutor vs. the taskScheduler Executor that @EnableScheduling
# registers). See KtDocumentController's @Qualifier("documentProcessorExecutor").
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
